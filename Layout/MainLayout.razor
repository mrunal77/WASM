@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="app-layout">
    <!-- Top Header Navigation -->
    <header class="app-header">
        <div class="header-brand">
            <button class="mobile-toggle-btn d-lg-none" @onclick="ToggleMobileMenu" aria-label="Toggle navigation menu">
                <i class="fa-solid @(isMobileMenuOpen ? "fa-xmark" : "fa-bars")" aria-hidden="true"></i>
            </button>
            <a href="" class="brand-link">
                <span class="brand-icon"><i class="fa-solid fa-bolt" aria-hidden="true"></i></span>
                <span class="brand-text">WASM Apps</span>
                <span class="brand-tag">v2.0</span>
            </a>
        </div>

        <div class="header-center">
            @if (!IsHome)
            {
                <a href="@HomeUri" class="nav-back-link" title="Return to Dashboard">
                    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                    <span class="d-none d-sm-inline">Back to Dashboard</span>
                </a>
            }
        </div>

        <div class="header-actions">
            <button class="theme-toggle-btn" @onclick="ToggleTheme" title="Toggle Light / Dark Mode" aria-label="Toggle light/dark theme">
                <i class="fa-solid @(currentTheme == "light" ? "fa-sun" : "fa-moon")" aria-hidden="true"></i>
                <span class="d-none d-md-inline ms-2">@(currentTheme == "light" ? "Light Mode" : "Dark Mode")</span>
            </button>

            <a href="https://github.com/mrunal77/WASM" target="_blank" rel="noopener noreferrer" class="github-link" title="View Source on GitHub">
                <i class="fa-brands fa-github" aria-hidden="true"></i>
                <span class="d-none d-md-inline ms-1">GitHub</span>
            </a>
        </div>
    </header>

    <div class="app-body">
        <!-- Sidebar Navigation Drawer -->
        <aside class="app-sidebar @(isMobileMenuOpen ? "is-open" : "")">
            <NavMenu OnNavigate="CloseMobileMenu" />
        </aside>

        @if (isMobileMenuOpen)
        {
            <div class="sidebar-overlay d-lg-none" @onclick="CloseMobileMenu"></div>
        }

        <!-- Main Content Area -->
        <main class="app-main">
            <div class="main-content">
                @Body
            </div>
        </main>
    </div>
</div>

@code {
    private bool isMobileMenuOpen = false;
    private string currentTheme = "dark";

    private bool IsHome => Navigation.Uri == Navigation.BaseUri;
    private string HomeUri => Navigation.BaseUri;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                currentTheme = await JS.InvokeAsync<string>("wasmTheme.get");
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            currentTheme = await JS.InvokeAsync<string>("wasmTheme.toggle");
        }
        catch
        {
            currentTheme = currentTheme == "dark" ? "light" : "dark";
        }
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }
}
