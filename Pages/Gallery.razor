@page "/gallery"
@inject IJSRuntime JS

<PageTitle>Webcam Photo Capture & Gallery — WASM Apps</PageTitle>

<HeadContent>
    <meta name="description" content="Capture photos with your webcam locally in your browser and view them in a private image gallery. 100% private." />
    <meta name="keywords" content="webcam capture, online photo gallery, browser webcam snapshot, take photo online" />
    <link rel="canonical" href="https://mrunal77.github.io/WASM/gallery" />
    <meta property="og:title" content="Webcam Photo Capture & Gallery — WASM Apps" />
    <meta property="og:description" content="Capture photos with your webcam locally in your browser and view them in a gallery." />
    <meta property="og:url" content="https://mrunal77.github.io/WASM/gallery" />
</HeadContent>

<h1>Image Gallery (Webcam)</h1>
<div class="mb-3">
    <video id="camVideo" style="max-width:100%;border:1px solid #ccc" autoplay muted></video>
</div>
<div class="mb-3">
    <button class="btn btn-secondary me-2" @onclick="StartCamera">Start Camera</button>
    <button class="btn btn-primary" @onclick="TakePhoto">Take Photo</button>
</div>
<div class="row mt-3">
    @foreach(var img in photos)
    {
        <div class="col-6 col-md-3 mb-3">
            <img src="@img" class="img-fluid" />
        </div>
    }
</div>

@code {
    private List<string> photos = new();

    private async Task StartCamera()
    {
        var result = await JS.InvokeAsync<string>("wasmGallery.startCamera", "camVideo");
        if (result != "ok")
        {
            // ignore or show message
        }
    }

    private async Task TakePhoto()
    {
        var data = await JS.InvokeAsync<string>("wasmGallery.takePhoto", "camVideo");
        if (!string.IsNullOrEmpty(data))
        {
            photos.Insert(0, data);
        }
    }
}
