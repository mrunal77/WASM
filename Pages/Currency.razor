@page "/currency"
@using System.Text.Json.Serialization
@inject HttpClient Http

<PageTitle>Currency</PageTitle>

<h1>Currency Converter</h1>

<div class="row mb-3">
    <div class="col-md-4">
        <input class="form-control" @bind="amount" type="number" step="any" />
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="baseCurrency">
            @foreach(var c in currencies) { <option value="@c">@c</option> }
        </select>
    </div>
    <div class="col-md-3">
        <select class="form-select" @bind="targetCurrency">
            @foreach(var c in currencies) { <option value="@c">@c</option> }
        </select>
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary" @onclick="Convert" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
            }
            Convert
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else if (converted != null)
{
    <div class="alert alert-success">@amount @baseCurrency = @converted.Value.ToString("F4") @targetCurrency</div>
}

@code {
    private decimal amount = 1m;
    private string baseCurrency = "USD";
    private string targetCurrency = "EUR";
    private decimal? converted;
    private string? errorMessage;
    private bool isLoading;
    private List<string> currencies = new() { "USD","EUR","GBP","INR","JPY","AUD","CAD" };

    private async Task Convert()
    {
        converted = null;
        errorMessage = null;
        isLoading = true;

        try
        {
            var url = $"https://open.er-api.com/v6/latest/{Uri.EscapeDataString(baseCurrency)}";
            var response = await Http.GetFromJsonAsync<ExchangeRatesResponse>(url);

            if (response?.Result != "success" || response.Rates is null)
            {
                errorMessage = "Exchange rates are unavailable right now. Please try again.";
                return;
            }

            if (!response.Rates.TryGetValue(targetCurrency, out var rate))
            {
                errorMessage = $"The {targetCurrency} exchange rate was not available.";
                return;
            }

            converted = amount * rate;
        }
        catch (Exception exception) when (exception is HttpRequestException || exception is NotSupportedException || exception is System.Text.Json.JsonException || exception is TaskCanceledException)
        {
            errorMessage = "Unable to reach the exchange-rate service. Please check your connection and try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class ExchangeRatesResponse
    {
        [JsonPropertyName("result")]
        public string? Result { get; set; }

        [JsonPropertyName("base_code")]
        public string? BaseCode { get; set; }

        [JsonPropertyName("rates")]
        public Dictionary<string, decimal>? Rates { get; set; }
    }
}
