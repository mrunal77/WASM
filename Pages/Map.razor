@page "/map"
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>Interactive World Map & Geolocation Viewer — WASM Apps</PageTitle>

<HeadContent>
    <meta name="description" content="Explore an interactive OpenStreetMap map with Leaflet tiles and browser geolocation support to center on your current position." />
    <meta name="keywords" content="interactive map, openstreetmap viewer, leaflet map app, geolocation map viewer, browser map" />
    <link rel="canonical" href="https://mrunal77.github.io/WASM/map" />
    <meta property="og:title" content="Interactive World Map & Geolocation Viewer — WASM Apps" />
    <meta property="og:description" content="Explore an interactive OpenStreetMap map with Leaflet tiles and browser geolocation support." />
    <meta property="og:url" content="https://mrunal77.github.io/WASM/map" />
</HeadContent>

<h1>Map</h1>
<p>Interactive map using OpenStreetMap + Leaflet. Click "Use my location" to center.</p>

<div class="mb-3">
    <button class="btn btn-primary me-2" @onclick="UseLocation">Use my location</button>
    <button class="btn btn-secondary" @onclick="ResetMap">Reset map view</button>
</div>

<div id="mapContainer" style="width:100%;height:400px;border:1px solid #ccc"></div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("wasmMap.initMap", "mapContainer", 0, 0, 2);
        }
    }

    private async Task UseLocation()
    {
        try
        {
            var pos = await JS.InvokeAsync<BrowserLocation>("geoLocation.getCurrentPosition");
            var lat = pos?.Latitude ?? 0;
            var lon = pos?.Longitude ?? 0;
            await JS.InvokeVoidAsync("wasmMap.initMap", "mapContainer", lat, lon, 12);
        }
        catch
        {
            await JS.InvokeVoidAsync("wasmMap.initMap", "mapContainer", 0, 0, 2);
        }
    }

    private async Task ResetMap()
    {
        await JS.InvokeVoidAsync("wasmMap.initMap", "mapContainer", 0, 0, 2);
    }

    private class BrowserLocation
    {
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
    }
}
