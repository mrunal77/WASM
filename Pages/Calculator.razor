@page "/calculator"
@using System.Globalization
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="calculator-container" @ref="calculatorRef" tabindex="0" aria-label="Calculator" role="region" @onkeydown="HandleKeyDown">
    <div class="calculator-header"
         @onmousedown="StartDrag"
         @ontouchstart="StartDrag">
        <span class="calculator-title">Calculator</span>
    </div>

    <div class="calculator-modes" role="tablist" aria-label="Calculator modes">
        @foreach (var mode in Modes)
        {
            <button type="button"
                    class="mode-btn @(calculatorMode == mode ? "active" : string.Empty)"
                    @onclick="() => SetMode(mode)"
                    role="tab"
                    aria-selected="@(calculatorMode == mode)">
                @mode
            </button>
        }
    </div>

    <div class="calculator-display" role="status" aria-live="polite">@DisplayValue</div>
    <div class="calculator-buttons" role="group" aria-label="Calculator buttons">
        @foreach (var row in ButtonRows)
        {
            <div class="calculator-row">
                @foreach (var button in row)
                {
                    <button class="calculator-btn"
                            @onclick="() => OnButtonClick(button.Label)"
                            aria-label="@button.AriaLabel"
                            disabled="@button.Disabled"
                            tabindex="0">
                        @button.Label
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    private ElementReference calculatorRef;
    private IJSObjectReference? dragModule;
    private DotNetObjectReference<Calculator>? dotNetRef;
    private bool isDragging = false;
    private double startX, startY;
    private double initialLeft = 45, initialTop = 20;
    private string input = string.Empty;
    private string lastOperator = string.Empty;
    private decimal? accumulator = null;
    private bool isNewEntry = true;
    private string? errorMessage;
    private string calculatorMode = "Standard";

    private string DisplayValue => errorMessage ?? (input == string.Empty ? (accumulator?.ToString("G", CultureInfo.InvariantCulture) ?? "0") : input);

    private class CalculatorButton
    {
        public string Label { get; set; } = string.Empty;
        public string AriaLabel { get; set; } = string.Empty;
        public bool Disabled { get; set; }
    }

    private static readonly string[] Modes = new[] { "Standard", "Scientific" };

    private static readonly List<List<CalculatorButton>> StandardRows = new()
    {
        new() { new() { Label = "CE", AriaLabel = "Clear entry" }, new() { Label = "C", AriaLabel = "Clear" }, new() { Label = "⌫", AriaLabel = "Backspace" }, new() { Label = "/", AriaLabel = "Divide" } },
        new() { new() { Label = "7", AriaLabel = "Seven" }, new() { Label = "8", AriaLabel = "Eight" }, new() { Label = "9", AriaLabel = "Nine" }, new() { Label = "*", AriaLabel = "Multiply" } },
        new() { new() { Label = "4", AriaLabel = "Four" }, new() { Label = "5", AriaLabel = "Five" }, new() { Label = "6", AriaLabel = "Six" }, new() { Label = "-", AriaLabel = "Subtract" } },
        new() { new() { Label = "1", AriaLabel = "One" }, new() { Label = "2", AriaLabel = "Two" }, new() { Label = "3", AriaLabel = "Three" }, new() { Label = "+", AriaLabel = "Add" } },
        new() { new() { Label = "±", AriaLabel = "Negate" }, new() { Label = "0", AriaLabel = "Zero" }, new() { Label = ".", AriaLabel = "Decimal point" }, new() { Label = "=", AriaLabel = "Equals" } }
    };

    private static readonly List<List<CalculatorButton>> ScientificRows = new()
    {
        new() { new() { Label = "sin", AriaLabel = "Sine" }, new() { Label = "cos", AriaLabel = "Cosine" }, new() { Label = "tan", AriaLabel = "Tangent" }, new() { Label = "√", AriaLabel = "Square root" } },
        new() { new() { Label = "ln", AriaLabel = "Natural logarithm" }, new() { Label = "log", AriaLabel = "Log base 10" }, new() { Label = "x²", AriaLabel = "Square" }, new() { Label = "1/x", AriaLabel = "Reciprocal" } },
        new() { new() { Label = "CE", AriaLabel = "Clear entry" }, new() { Label = "C", AriaLabel = "Clear" }, new() { Label = "⌫", AriaLabel = "Backspace" }, new() { Label = "x^y", AriaLabel = "Power" } },
        new() { new() { Label = "7", AriaLabel = "Seven" }, new() { Label = "8", AriaLabel = "Eight" }, new() { Label = "9", AriaLabel = "Nine" }, new() { Label = "/", AriaLabel = "Divide" } },
        new() { new() { Label = "4", AriaLabel = "Four" }, new() { Label = "5", AriaLabel = "Five" }, new() { Label = "6", AriaLabel = "Six" }, new() { Label = "*", AriaLabel = "Multiply" } },
        new() { new() { Label = "1", AriaLabel = "One" }, new() { Label = "2", AriaLabel = "Two" }, new() { Label = "3", AriaLabel = "Three" }, new() { Label = "-", AriaLabel = "Subtract" } },
        new() { new() { Label = "%", AriaLabel = "Percent" }, new() { Label = "0", AriaLabel = "Zero" }, new() { Label = ".", AriaLabel = "Decimal point" }, new() { Label = "=", AriaLabel = "Equals" } }
    };

    private IEnumerable<List<CalculatorButton>> ButtonRows => calculatorMode == "Scientific" ? ScientificRows : StandardRows;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            dragModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/CalculatorDrag.cs.js");
            await dragModule.InvokeVoidAsync("enableCSDrag", calculatorRef, dotNetRef);
            await calculatorRef.FocusAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (dragModule != null)
        {
            try
            {
                await dragModule.InvokeVoidAsync("disableCSDrag");
                await dragModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Ignore if circuit is disconnected
            }
        }
        dotNetRef?.Dispose();
    }

    private async Task StartDrag(MouseEventArgs e)
    {
        if (dragModule is null) return;

        isDragging = true;
        startX = e.ClientX;
        startY = e.ClientY;

        var rect = await dragModule.InvokeAsync<ClientRect>("getElementRect", calculatorRef);
        initialLeft = rect.Left;
        initialTop = rect.Top;

        await dragModule.InvokeVoidAsync("setDragging", true);
    }

    private async Task StartDrag(TouchEventArgs e)
    {
        if (dragModule is null || e.Touches.Length != 1) return;

        isDragging = true;
        startX = e.Touches[0].ClientX;
        startY = e.Touches[0].ClientY;

        var rect = await dragModule.InvokeAsync<ClientRect>("getElementRect", calculatorRef);
        initialLeft = rect.Left;
        initialTop = rect.Top;

        await dragModule.InvokeVoidAsync("setDragging", true);
    }

    [JSInvokable]
    public async Task HandleMouseMove(double clientX, double clientY)
    {
        if (!isDragging) return;

        var dx = clientX - startX;
        var dy = clientY - startY;

        var newLeft = initialLeft + dx;
        var newTop = initialTop + dy;

        await UpdateCalculatorPosition(newLeft, newTop);
    }

    [JSInvokable]
    public async Task HandleTouchMove(double clientX, double clientY)
    {
        if (!isDragging) return;

        var dx = clientX - startX;
        var dy = clientY - startY;

        var newLeft = initialLeft + dx;
        var newTop = initialTop + dy;

        await UpdateCalculatorPosition(newLeft, newTop);
    }

    private async Task UpdateCalculatorPosition(double left, double top)
    {
        if (dragModule is null) return;
        await dragModule.InvokeVoidAsync("updateCalculatorPosition", calculatorRef, left, top);
    }

    [JSInvokable]
    public void StopDrag()
    {
        isDragging = false;
    }

    private void SetMode(string mode)
    {
        if (calculatorMode == mode) return;
        calculatorMode = mode;
        input = string.Empty;
        lastOperator = string.Empty;
        accumulator = null;
        errorMessage = null;
        isNewEntry = true;
    }

    private void OnButtonClick(string label)
    {
        if (errorMessage != null)
        {
            errorMessage = null;
            input = string.Empty;
            lastOperator = string.Empty;
            accumulator = null;
            isNewEntry = true;
        }

        if (char.IsDigit(label, 0) || label == ".")
        {
            if (isNewEntry)
            {
                input = string.Empty;
                isNewEntry = false;
            }
            if (label == "." && input.Contains(".")) return;
            input += label;
            return;
        }

        if (label == "C")
        {
            input = string.Empty;
            lastOperator = string.Empty;
            accumulator = null;
            errorMessage = null;
            isNewEntry = true;
            return;
        }

        if (label == "CE")
        {
            input = string.Empty;
            isNewEntry = true;
            return;
        }

        if (label == "⌫")
        {
            if (!isNewEntry && input.Length > 0)
            {
                input = input.Substring(0, input.Length - 1);
            }
            return;
        }

        if (label == "=")
        {
            CommitInput();
            lastOperator = string.Empty;
            isNewEntry = true;
            return;
        }

        if (label == "+" || label == "-" || label == "*" || label == "/" || label == "x^y")
        {
            CommitInput();
            lastOperator = label == "x^y" ? "^" : label;
            isNewEntry = true;
            return;
        }

        ApplyUnaryOperation(label);
    }

    private void ApplyUnaryOperation(string operation)
    {
        var value = GetCurrentValue();
        if (value == null)
        {
            errorMessage = "Enter a number first.";
            return;
        }

        try
        {
            var numericValue = (double)value.Value;
            double result = operation switch
            {
                "±" => -numericValue,
                "%" => numericValue / 100.0,
                "√" => numericValue < 0 ? throw new InvalidOperationException("Cannot take square root of a negative number") : Math.Sqrt(numericValue),
                "x²" => numericValue * numericValue,
                "1/x" => numericValue == 0 ? throw new DivideByZeroException() : 1.0 / numericValue,
                "sin" => Math.Sin(DegreesToRadians(numericValue)),
                "cos" => Math.Cos(DegreesToRadians(numericValue)),
                "tan" => Math.Tan(DegreesToRadians(numericValue)),
                "ln" => numericValue <= 0 ? throw new InvalidOperationException("Natural log is undefined for zero or negative numbers") : Math.Log(numericValue),
                "log" => numericValue <= 0 ? throw new InvalidOperationException("Logarithm is undefined for zero or negative numbers") : Math.Log10(numericValue),
                _ => throw new InvalidOperationException("Unknown operation")
            };

            accumulator = (decimal)result;
            input = accumulator.Value.ToString(CultureInfo.InvariantCulture);
            isNewEntry = true;
            lastOperator = string.Empty;
        }
        catch (DivideByZeroException)
        {
            errorMessage = "Cannot divide by zero";
            accumulator = null;
            input = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            accumulator = null;
            input = string.Empty;
        }
    }

    private double DegreesToRadians(double degrees) => degrees * Math.PI / 180.0;

    private decimal? GetCurrentValue()
    {
        if (!string.IsNullOrEmpty(input) && decimal.TryParse(input, NumberStyles.Number, CultureInfo.InvariantCulture, out var value))
        {
            return value;
        }

        return accumulator;
    }

    private void CommitInput()
    {
        if (string.IsNullOrEmpty(input) && !accumulator.HasValue)
        {
            return;
        }

        if (!decimal.TryParse(input, NumberStyles.Number, CultureInfo.InvariantCulture, out var value))
        {
            errorMessage = "Invalid input";
            return;
        }

        if (accumulator == null)
        {
            accumulator = value;
        }
        else if (!string.IsNullOrEmpty(lastOperator))
        {
            try
            {
                accumulator = lastOperator switch
                {
                    "+" => accumulator + value,
                    "-" => accumulator - value,
                    "*" => accumulator * value,
                    "/" => value == 0 ? throw new DivideByZeroException() : accumulator / value,
                    "^" => (decimal)Math.Pow((double)accumulator, (double)value),
                    _ => accumulator
                };
            }
            catch (DivideByZeroException)
            {
                errorMessage = "Cannot divide by zero";
                accumulator = null;
            }
        }

        input = string.Empty;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key.Length == 1 && char.IsDigit(e.Key[0]))
            OnButtonClick(e.Key);
        else if (e.Key == "Enter" || e.Key == "=")
            OnButtonClick("=");
        else if (e.Key == "Backspace")
            OnButtonClick("⌫");
        else if (e.Key == "Escape")
            OnButtonClick("C");
        else if ("+-*/.".Contains(e.Key))
            OnButtonClick(e.Key);
    }

    private void CloseCalculator()
    {
        input = string.Empty;
        lastOperator = string.Empty;
        accumulator = null;
        errorMessage = null;
        isNewEntry = true;
    }

    private class ClientRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }
}
