@page "/counter"

<PageTitle>Simple Online Tally Counter — WASM Apps</PageTitle>

<HeadContent>
    <meta name="description" content="A simple online click counter demo running 100% in your browser using Blazor WebAssembly." />
    <meta name="keywords" content="click counter, online tally counter, clicker app, simple counter demo" />
    <link rel="canonical" href="https://mrunal77.github.io/WASM/counter" />
    <meta property="og:title" content="Simple Online Tally Counter — WASM Apps" />
    <meta property="og:description" content="A simple online click counter demo running 100% in your browser." />
    <meta property="og:url" content="https://mrunal77.github.io/WASM/counter" />
</HeadContent>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
