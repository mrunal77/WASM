@page "/code-screenshot"
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Code Screenshot Generator</PageTitle>

<h1>Code Screenshot Generator</h1>
<p class="text-muted">Paste code, pick a language and theme, then download it as an image or copy it.</p>

<div class="row g-4">
    <div class="col-xl-4 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title mb-3">Settings</h5>

                <div class="mb-3">
                    <label class="form-label" for="lang-select">Language</label>
                    <select id="lang-select" class="form-select" value="@currentLanguage" @onchange="OnLanguageChange">
                        @foreach (var lang in Languages)
                        {
                            <option value="@lang.Key">@lang.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="theme-select">Theme</label>
                    <select id="theme-select" class="form-select" value="@currentTheme" @onchange="OnThemeChange">
                        @foreach (var theme in Themes)
                        {
                            <option value="@theme.Key">@theme.Name</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="title-input">File name</label>
                    <input id="title-input" class="form-control" value="@title" @oninput="OnTitleInput" />
                </div>

                <div class="mb-3">
                    <label class="form-label d-flex justify-content-between" for="size-range">
                        <span>Font size</span><span>@fontSize px</span>
                    </label>
                    <input id="size-range" type="range" class="form-range" min="12" max="24" step="1" value="@fontSize" @oninput="OnFontSizeInput" />
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input id="line-numbers" class="form-check-input" type="checkbox" checked="@showLineNumbers" @onchange="OnLineNumbersChange" />
                        <label class="form-check-label" for="line-numbers">Show line numbers</label>
                    </div>
                    <div class="form-check">
                        <input id="window-chrome" class="form-check-input" type="checkbox" checked="@showWindowChrome" @onchange="OnWindowChromeChange" />
                        <label class="form-check-label" for="window-chrome">Show window controls</label>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="code-input">Code</label>
                    <textarea id="code-input" class="form-control code-input" value="@codeInput" @oninput="OnCodeInput" spellcheck="false"></textarea>
                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadSample">
                            <i class="fa fa-magic me-1" aria-hidden="true"></i> Load sample for @CurrentLanguageName
                        </button>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary" @onclick="DownloadPngAsync">
                        <i class="fa fa-download me-1" aria-hidden="true"></i> Download PNG
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CopyImageAsync">
                        <i class="fa fa-image me-1" aria-hidden="true"></i> Copy Image
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CopyCodeAsync">
                        <i class="fa fa-copy me-1" aria-hidden="true"></i> Copy Code
                    </button>
                </div>

                @if (statusMessage is not null)
                {
                    <div class="mt-3 @(isError ? "status-error" : "status-ok")" role="status" aria-live="polite">@statusMessage</div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-8 col-lg-7">
        <div class="snippet-stage">
            <div class="snippet-stage-inner">
                <div @ref="previewRef"></div>
            </div>
        </div>
        <p class="text-muted small mt-2 mb-0">The preview updates as you type. “Copy Image” puts the PNG directly on your clipboard.</p>
    </div>
</div>

@code {
    private string currentLanguage = "csharp";
    private string currentTheme = "one-dark";
    private string title = "hello.cs";
    private double fontSize = 15;
    private bool showLineNumbers = true;
    private bool showWindowChrome = true;
    private string codeInput = string.Empty;
    private string? statusMessage;
    private bool isError;
    private ElementReference previewRef;
    private CancellationTokenSource? statusCts;

    private string CurrentLanguageName => Languages.First(l => l.Key == currentLanguage).Name;
    private CodeLanguage CurrentLanguage => Languages.First(l => l.Key == currentLanguage);

    private record CodeLanguage(string Key, string Name, string Extension, string Sample);
    private record ThemeOption(string Key, string Name);

