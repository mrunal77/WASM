    protected override void OnInitialized()
    {
        codeInput = CurrentLanguage.Sample;
        title = $"hello.{CurrentLanguage.Extension}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RenderPreviewAsync();
        }
    }

    private async Task RenderPreviewAsync()
    {
        if (previewRef.Context is null) return;
        await JS.InvokeVoidAsync("wasmCodeGen.render", previewRef, codeInput, currentLanguage, CurrentLanguageName, currentTheme, title, fontSize, showLineNumbers, showWindowChrome);
    }

    private async Task OnLanguageChange(ChangeEventArgs e)
    {
        var previous = currentLanguage;
        currentLanguage = e.Value?.ToString() ?? currentLanguage;
        if (title == SuggestedTitle(previous))
        {
            title = SuggestedTitle(currentLanguage);
        }
        await RenderPreviewAsync();
    }

    private async Task OnThemeChange(ChangeEventArgs e)
    {
        currentTheme = e.Value?.ToString() ?? currentTheme;
        await RenderPreviewAsync();
    }

    private async Task OnTitleInput(ChangeEventArgs e)
    {
        title = e.Value?.ToString() ?? string.Empty;
        await RenderPreviewAsync();
    }

    private async Task OnFontSizeInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var size))
        {
            fontSize = size;
        }
        await RenderPreviewAsync();
    }

    private async Task OnLineNumbersChange(ChangeEventArgs e)
    {
        showLineNumbers = e.Value is not null;
        await RenderPreviewAsync();
    }

    private async Task OnWindowChromeChange(ChangeEventArgs e)
    {
        showWindowChrome = e.Value is not null;
        await RenderPreviewAsync();
    }

    private async Task OnCodeInput(ChangeEventArgs e)
    {
        codeInput = e.Value?.ToString() ?? string.Empty;
        await RenderPreviewAsync();
    }

    private async Task LoadSample()
    {
        codeInput = CurrentLanguage.Sample;
        title = SuggestedTitle(currentLanguage);
        ShowStatus($"Loaded a {CurrentLanguage.Name} sample.", false);
        await RenderPreviewAsync();
    }

    private static string SuggestedTitle(string languageKey) =>
        $"hello.{Languages.First(l => l.Key == languageKey).Extension}";

    private async Task DownloadPngAsync()
    {
        var result = await JS.InvokeAsync<string>("wasmCodeGen.downloadPng", previewRef, GetPngFilename(title));
        ShowStatus(result == "ok" ? "PNG image downloaded." : $"Could not create the image: {result}", result != "ok");
    }

    private async Task CopyImageAsync()
    {
        var result = await JS.InvokeAsync<string>("wasmCodeGen.copyImage", previewRef);
        ShowStatus(result == "ok" ? "Image copied to clipboard." : $"Could not copy the image: {result}", result != "ok");
    }

    private async Task CopyCodeAsync()
    {
        var result = await JS.InvokeAsync<string>("wasmCodeGen.copyCode", codeInput);
        ShowStatus(result == "ok" ? "Code copied to clipboard." : $"Could not copy the code: {result}", result != "ok");
    }

    private static string GetPngFilename(string value)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var safe = new string((value ?? string.Empty).Where(c => !invalid.Contains(c)).ToArray()).Trim();
        if (string.IsNullOrWhiteSpace(safe))
        {
            safe = "code-screenshot";
        }
        return safe + (safe.EndsWith(".png", StringComparison.OrdinalIgnoreCase) ? string.Empty : ".png");
    }

    private void ShowStatus(string message, bool error)
    {
        statusCts?.Cancel();
        statusMessage = message;
        isError = error;
        statusCts = new CancellationTokenSource();
        _ = HideStatusAsync(statusCts.Token);
    }

    private async Task HideStatusAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(3500, token);
            statusMessage = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
        }
    }

    public void Dispose()
    {
        statusCts?.Cancel();
        statusCts?.Dispose();
    }
}